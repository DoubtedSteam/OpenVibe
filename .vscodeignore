# VS Code 配置
.vscode

# 版本控制
.gitignore
**/.git
**/.svn
**/.hg
**/CVS

# 系统文件
**/.DS_Store
**/Thumbs.db

# 测试
.vscode-test

# node_modules（已通过 esbuild 打包到 out/extension.js，无需包含在 VSIX 中）
# 例外：playwright 需要原生二进制，无法被 esbuild 打包，必须在运行时加载
node_modules/**
!node_modules/playwright/
!node_modules/playwright-core/
!node_modules/chromium-bidi/

# TypeScript 源文件（已编译到 out/）
src
tsconfig.json
**/*.ts

# Sourcemap（调试用，发布时排除）
**/*.map

# 旧的构建产物
*.vsix

# 本地开发数据
.OpenVibe/

# 文档与图片
imgs
logo.png

# 依赖锁定与构建脚本
package-lock.json
esbuild.mjs

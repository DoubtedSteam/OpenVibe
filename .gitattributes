# Auto-detect text files and normalize to LF
* text=auto

# Source code — LF line endings
*.ts        text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.css       text eol=lf
*.html      text eol=lf

# Shell scripts — LF
*.sh        text eol=lf
*.bash      text eol=lf

# Windows batch — CRLF (native)
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary files — no conversion
*.png       binary
*.ico       binary
*.svg       binary
*.vsix      binary

# Git diff settings for better diffs
*.ts        diff=typescript
*.js        diff=javascript
*.json      diff=json
*.md        diff=markdown
*.mjs       diff=javascript
